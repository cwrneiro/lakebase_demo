# Local development only — do not commit values.
# Required for `scripts/local-dev.sh` to authenticate against your workspace.

# Databricks CLI profile name (run `databricks auth profiles` to list)
DATABRICKS_PROFILE=<your-workspace-profile>

# Lakebase endpoint resource path (filled in by bootstrap.sh after deploy)
ENDPOINT_NAME=projects/lakebase-demo/branches/production/endpoints/primary

# Foundation Model serving endpoint
SERVING_ENDPOINT=databricks-claude-sonnet-4-5

# Toggle the LLM "explain this score" panel
ENABLE_LLM_EXPLAIN=true
